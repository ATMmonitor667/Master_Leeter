# ── Core services ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://leeter:leeter@localhost:5432/leeter
REDIS_URL=redis://localhost:6379

API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# ── Realtime voice (M0-1, M3) ────────────────────────────────────────────────
# Server-side only. This key must NEVER reach the browser — the client receives
# a short-lived ephemeral credential minted by POST /realtime-token (M3-1).
REALTIME_API_KEY=
# Current GA voice model (M0-1 spike). Confirm against OpenAI docs if this drifts.
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=alloy

# ── Code execution (M0-2, M2-4) ──────────────────────────────────────────────
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
RUNNER_CPU_LIMIT_SECONDS=5
RUNNER_WALL_LIMIT_SECONDS=10
RUNNER_MEMORY_LIMIT_KB=262144
RUNNER_MAX_PROCESSES=32

# ── Reasoning models (M4, M5, M6) ────────────────────────────────────────────
# Fast/cheap — every turn (M4-1). Swap only if unit economics force it.
CLASSIFIER_MODEL=gpt-5-nano
# Decent reasoning, async between turns (M5-1).
OBSERVER_MODEL=gpt-5-mini
# Best available; once per session (M6-2). Latency irrelevant.
EVALUATOR_MODEL=gpt-5.2

# ── Observability (M7-2) ─────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=master-leeter-api

# ── Privacy (M7-3) ───────────────────────────────────────────────────────────
# Raw audio retention is OFF by default and must stay off without explicit
# per-user consent. See CLAUDE.md invariant 10.
RETAIN_RAW_AUDIO=false
