# ── Core services ────────────────────────────────────────────────────────────
# Supabase is PostgreSQL. Use the development project's direct or pooler
# connection string here; the public URL/key cannot perform server transactions.
DATABASE_URL=
REDIS_URL=redis://localhost:6379

API_PORT=4000
# Hosting platforms normally inject PORT; it takes precedence over API_PORT.
PORT=
WEB_ORIGIN=http://localhost:3000
# Mark hosted web builds as preview or production. Vercel refuses a hosted build
# without secure public endpoints and Supabase browser authentication.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
# Readiness turns unavailable before shutdown waits this long and closes sockets.
DRAIN_GRACE_MS=5000
# Safe commit/image identifier returned by health endpoints.
RELEASE_SHA=development

# ── Admission and provider-cost bounds ──────────────────────────────────────
# Flip to false to stop NEW interviews. Existing sessions continue to their
# deadline/end path so acknowledged work and reports are not discarded.
ADMISSION_ENABLED=true
# Serialized in Supabase across API replicas before a session row is created.
MAX_ACTIVE_INTERVIEWS=10
MONTHLY_INTERVIEWS_PER_USER=10
# Provider credentials remain additionally capped for the lifetime of a session.
MAX_REALTIME_MINTS_PER_SESSION=12
# Atomic Supabase-backed one-minute buckets for expensive public routes.
SESSION_CREATES_PER_MINUTE=5
PREPARATIONS_PER_MINUTE=5
REALTIME_MINTS_PER_MINUTE=6
RUN_REQUESTS_PER_MINUTE=10
SUPPORT_REPORTS_PER_MINUTE=3

# Question bank: files for local/offline development, supabase for deployment.
# NODE_ENV=production defaults to supabase and refuses file-backed selection.
QUESTION_BANK_SOURCE=files
AUTH_MODE=development
# Local offline use requires all three flags; never use these on a hosted API.
NODE_ENV=development
ALLOW_INSECURE_DEV=1
# Public Supabase key used by the API to verify signed-in users (not service-role).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
# Server-only sb_secret_ key. Never set a NEXT_PUBLIC_ variant or commit a key.
SUPABASE_SECRET_KEY=
# Optional legacy alternative; must be a service_role JWT, never an anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Browser sign-in. Production always requires sign-in; use supabase locally too
# when testing auth. These must be the URL and PUBLIC key of the same project.
NEXT_PUBLIC_AUTH_MODE=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Realtime voice (M0-1, M3) ────────────────────────────────────────────────
# Server-side only. This key must NEVER reach the browser — the client receives
# a short-lived ephemeral credential minted by POST /realtime-token (M3-1).
REALTIME_API_KEY=
# Provider: openai | gemini (auto-detected from model name if omitted)
REALTIME_PROVIDER=gemini
# Gemini Live — use a model with the -live- or native-audio suffix (see Google docs).
REALTIME_MODEL=gemini-2.5-flash-native-audio-latest
# Gemini prebuilt voices include Puck, Charon, Kore, Fenrir, Aoede.
# Optional — defaults to Charon (see modules/realtime/persona.ts). Puck is bright
# and eager, which demos well and interviews badly; prosody carries as much of
# "this is an interview" as the words do. A starting point, not a finding.
REALTIME_VOICE=Charon
# How long a minted ephemeral credential stays valid (M3-1). The browser gets one
# of these, never the key above. Short on purpose — a drop mints a new one, and
# the window to *open* a session is shorter still (60s, not configurable).
REALTIME_TOKEN_TTL_SECONDS=600
# Cache authored speech after Gemini TTS; an uncached line uses realtime voice.
TTS_PRERENDER=on
TTS_MODEL=gemini-2.5-flash-preview-tts
# Render verification is required in production; off is for local diagnostics.
TTS_VERIFY=on
TTS_VERIFY_MODEL=gemini-3.5-transcribe
# Turn-end prediction is enabled by default; either switch restores clock-only timing.
NEXT_PUBLIC_TURN_PREDICTOR=on
TURN_END_PROSODY=on

# ── Code checking (M2-4) ─────────────────────────────────────────────────────
# `simplified` branch: candidate code is NEVER executed. A model reads it and
# predicts the result. Cheap and fast matters more than clever — this runs on
# every Run click. Uses GEMINI_API_KEY, falling back to REALTIME_API_KEY.
#
# A judged run is a PREDICTION. Do not read run results, milestones, or
# evaluator scores as measurements on this branch. `main` keeps Judge0.
JUDGE_MODEL=gemini-3.5-flash
# Advisory only on this branch — nothing enforces them, the judge is just told
# about the wall limit so it can report TIMEOUT for non-terminating code.
RUNNER_CPU_LIMIT_SECONDS=5
RUNNER_WALL_LIMIT_SECONDS=10
RUNNER_MEMORY_LIMIT_KB=262144
RUNNER_MAX_PROCESSES=32

# ── Reasoning models (M4, M5, M6) ────────────────────────────────────────────
# All Gemini. One provider, one key, one free-tier quota to budget against.
#
# Optional — falls back to REALTIME_API_KEY, since one Google AI Studio key
# serves both the Live API and the text models.
GEMINI_API_KEY=
#
# Fast/cheap — runs on EVERY finalized candidate turn (M4-1), on the critical
# path between the candidate stopping and the interviewer being allowed to
# speak. Thinking is disabled for this role; latency is the constraint.
CLASSIFIER_MODEL=gemini-3.5-flash-lite
# Budget before the classifier gives up and falls back to rules. Sits in front
# of a voice path already at p50 ≈ 1.0s to first audio byte (ADR-001).
CLASSIFIER_TIMEOUT_MS=1200
# Decent reasoning, async between turns, never on the critical path (M5-1).
OBSERVER_MODEL=gemini-3.6-flash
# Strongest available; once per session, offline (M6-2). Latency irrelevant.
EVALUATOR_MODEL=gemini-3.5-flash
# Preparation runs before the 45-minute clock and safely falls back to canonical text.
RESUME_ANALYZER_MODEL=gemini-3.5-flash
RESTATEMENT_MODEL=gemini-3.5-flash

# ── Operator-only database recovery ──────────────────────────────────────────
# These are consumed only by scripts/database-recovery.mjs, never by the API.
# Use PostgreSQL connection strings from a secret store and an isolated target.
BACKUP_DATABASE_URL=
MIGRATION_DATABASE_URL=
MIGRATION_CONFIRM_DATABASE=
RESTORE_DATABASE_URL=
METRICS_DATABASE_URL=
RESTORE_CONFIRM_DATABASE=
RESTORE_ISOLATED_ACK=
ERASURE_LEDGER_DATABASE_URL=
ERASURE_REPLAY_ACK=

# Completed interview evidence is automatically tombstoned and redacted after
# this many days. The production default is 365 and must be stated in policy copy.
SESSION_RETENTION_DAYS=365

# ── Observability (M7-2) ─────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=master-leeter-api
# Optional HTTPS endpoint for redacted critical operational alerts. The token is
# sent as a Bearer credential and is invalid without a webhook URL.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# ── Privacy (M7-3) ───────────────────────────────────────────────────────────
# Raw audio retention is OFF by default and must stay off without explicit
# per-user consent. See CLAUDE.md invariant 10.
RETAIN_RAW_AUDIO=false
